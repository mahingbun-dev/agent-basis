# Eterna Agent 容器部署环境样例:cp .env.example .env 后填写
# 模型网关密钥(本机: cat .secrets/litellm-master-key.txt)
LITELLM_API_KEY=
# 模型网关 openai-completions 根(baseURL 带 /v1;适配器追加 chat/completions)
ETERNA_LLM_BASE_URL=http://192.168.31.165:4000/v1
# 外网反代(用户配置 NAS 反代后填;重 compose up 即热生效)
ETERNA_PUBLIC_URL=
ETERNA_TRUSTED_HOST=
# 账号门禁(eterna-access):管理员账号首启播种(用户表为空时生效,之后改密走 UI)
ETERNA_ACCESS_ADMIN_USER=
ETERNA_ACCESS_ADMIN_PASSWORD=
# 会话签名密钥(留空=自动生成落卷 secret.key;设置后旧会话全体下线)
ETERNA_ACCESS_SECRET=
# 反代终结 TLS 时设 1(Secure cookie + 同源校验按 https)
ETERNA_ACCESS_SECURE=
