{
  "name": "@eterna/root",
  "description": "领域 Agent 基座 monorepo:L1 基座插件 + L2 领域包,构建于 DeepSeek Harness (DSH) 之上。设计文档见 README.md。",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "verify": "node scripts/lint-ui-tokens.mjs && pnpm -r --if-present run verify",
    "lint": "oxlint .",
    "lint:ui": "node scripts/lint-ui-tokens.mjs",
    "test": "pnpm -r --if-present run test",
    "test:profile": "node --test docker/profile/transplant-profile.test.mjs"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.5"
  }
}
