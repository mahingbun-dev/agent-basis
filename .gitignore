# 本地运行态与不入库目录(basis 启动器实验包、T1/T7 隔离宿主 home、ZCode 工作流草稿;内含内网端点等本机信息)
/basis/
/.basis/
/.eterna/
/.basis-home*/
/.eterna-home*/
/.zcode/
/scripts/init-profile.mjs
/scripts/smoke.mjs
/.eterna-gate-home*/

# T7 隔离宿主 home(super 门禁在仓库根生成):含凭据/账号库/会话日志/工作区 SQLite
# ——2026-11-19 事故:f02a8c3 误把 25 个文件提交,其中 .credentials.yaml(授予 secret)
# 与 access/secret.key(HMAC 签名钥)被推到 PUBLIC 仓库,同时导致 CI G1-2 因
# 检出后 644 权限被 credentials-local 拒启。本地运行态永不入库。
/.eterna-super-home*/
packages/browser-relay/smoke/.browsers/
packages/browser-relay/smoke/.gate-relay-port

# E2E 浏览器 profile 运行态(不入库)
acceptance/**/profile*
gui-test-screenshots/**/profile*

# 思考强度回放语料(生产日志抽样,永不入库)
corpus/
