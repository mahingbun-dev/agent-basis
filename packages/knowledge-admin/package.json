{
  "name": "@eterna/knowledge-admin",
  "version": "0.1.0",
  "private": true,
  "description": "知识底座插件(唯一宿主):本地知识库四工具 knowledge_search/read/status/propose + 知识库管理工作台(knowledge_admin、侧栏「知识库」、提案审批、检索问答、导入、成员、审计)。多租户按账号物理分库;Agent 写入一律 pending,人工在面板审批/直接发布。",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test:client": "node tests/render-smoke.cjs",
    "typecheck": "../../node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "test": "../../node_modules/.bin/vitest run",
    "verify": "node scripts/build-client.mjs && node tests/render-smoke.cjs && ../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ../../node_modules/.bin/tsc --noEmit -p tsconfig.json && ../../node_modules/.bin/vitest run"
  },
  "files": [
    "dist",
    "lib",
    "locale",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "src",
    "tsconfig.json",
    "tsconfig.build.json",
    "scripts",
    "tests"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@eterna/knowledge": "workspace:*",
    "@eterna/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
