{
  "name": "@eterna/attachments",
  "description": "附件入口:DSH Web 客户端插件——在输入框工具行(官方席位 conversation.input.left)贡献常驻「附件」按钮,点击经 uiConversation.createDrafts 把浏览器文件注册为草稿附件(图片/文件上传、预览、失败重试全部复用上游 ui-attachment 附件栏与 file-upload 链路,本包不自建上传管线)。Host 半边为 idle 装载载具(客户端双面包需宿主 Loader 条目)。",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "verify": "node scripts/build-client.mjs && ../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/vitest run",
    "test": "./node_modules/.bin/vitest run",
    "typecheck": "./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@eterna/ui": "workspace:*",
    "@deepseek-ai/cordis": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
