    "./icon-data": "./src/icon-data.ts",
    "./package.json": "./package.json",
    "./react": "./src/react.ts"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "test": "../../node_modules/.bin/vitest run",
    "verify": "../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ../../node_modules/.bin/tsc --noEmit && ../../node_modules/.bin/vitest run"
  }
}
