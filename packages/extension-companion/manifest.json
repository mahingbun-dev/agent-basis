{
  "manifest_version": 3,
  "name": "Eterna Companion",
  "description": "把你的浏览器作为 eterna agent 的执行面（开发版，E1）",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "scripting"],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
