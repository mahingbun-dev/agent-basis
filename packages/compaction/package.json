{
  "name": "@eterna/compaction",
  "description": "Eterna 本地化上下文压缩：自动摘要后端 + /compact 命令 + 工具结果精简 + 设置分区（状态可读/阈值可调）。",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./basic-plugin": "./src/basic/index.ts",
    "./command-plugin": "./src/command-plugin.ts",
    "./pruner-plugin": "./src/pruner/index.ts",
    "./admin-plugin": "./src/admin-plugin.ts",
    "./client": "./lib/client.js",
    "./locale/basic/*.json": "./locale/basic/*.json",
    "./locale/command/*.json": "./locale/command/*.json",
    "./locale/pruner/*.json": "./locale/pruner/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "../../node_modules/.bin/tsc --noEmit",
    "verify": "node scripts/build-client.mjs && ../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ../../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-compaction": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-token-meter": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@deepseek-ai/dsh-util-values": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@eterna/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
