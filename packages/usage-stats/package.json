{
  "name": "@eterna/usage-stats",
  "description": "用量统计插件:聚合会话日志 usage(互斥四桶/缓存命中率/趋势/热力),浏览器半边贡献「用量统计」面板(main keyed 面板+sidebar 入口),Host 半边经 Typert SRC 端点 eternaUsageStats/stats 暴露聚合(归属=access 账本唯一事实源,admin 可看全局)。装载走 @eterna/panel 同款一行两面配方。",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "verify": "node scripts/build-client.mjs && ../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/vitest run",
    "test": "./node_modules/.bin/vitest run",
    "typecheck": "./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@eterna/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "esbuild": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:"
  }
}
