{
  "name": "@basis/panel",
  "description": "基座面板:DSH Web 双面插件——浏览器半边在侧栏贡献「基座面板」入口并渲染三区块面板(服务清单/操作指引/可观测样例),Host 半边经官方 Typert 网关 SRC 端点 basisPanel/snapshot 暴露只读快照(governance 规则/审计、memory 实体、knowledge 后端健康、@event 工具清单+R3 标记、最近会话 token/缓存命中)。装载走 @basis/glue 同款 bundle 配方(cordis.patch.yml insert + dsh.client 声明)。",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "verify": "node scripts/build-client.mjs && ../../node_modules/.bin/oxlint --config ../../.oxlintrc.json . && ./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/vitest run",
    "test": "./node_modules/.bin/vitest run",
    "typecheck": "./node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@basis/governance": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
