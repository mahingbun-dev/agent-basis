{
  "name": "@basis/glue",
  "description": "组合层 glue bundle:把 @basis 的 memory/knowledge/governance 服务装配为真实 DSH 宿主可挂载的插件(注册模型面工具 + systemPrompt 记忆索引 + ctx.governance 服务)。本包不含业务逻辑——全部能力来自 @basis/* 包,这里只做 Cordis 装配。",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./memory-plugin": "./src/plugins/memory-plugin.ts",
    "./knowledge-plugin": "./src/plugins/knowledge-plugin.ts",
    "./governance-plugin": "./src/plugins/governance-plugin.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify": "oxlint --config ../../.oxlintrc.json . && tsc --noEmit && vitest run --passWithNoTests",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@basis/governance": "workspace:*",
    "@basis/knowledge": "workspace:*",
    "@basis/memory": "workspace:*",
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
