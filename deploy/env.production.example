# EternaAgent 生产环境配置模板

> 用法：`cp deploy/env.production.example .env` 后填写密钥类占位。
> **`.env` 已被 gitignore——密钥真值只存在于机器上的 `.env`，绝不入库。**
> 变更任意值后 `docker compose up -d` 生效（entrypoint 每次启动重渲染 profile）。

# ── 模型网关 ──────────────────────────────────────────────
# 三家直连密钥(P2 网关,网关已退场)
DEEPSEEK_API_KEY=<必填>
MIMO_API_KEY=<必填>
BIGMODEL_API_KEY=<必填>
# OpenDesign(Go 套餐)直连(2026-11-12):可选,不填则模型选择器 OpenDesign 分组不可用
OPENDESIGN_API_KEY=<可选:sk-amr- 开头的 Go 套餐 key>

# ── 账号门禁（eterna-access）────────────────────────────
# 管理员账号：首次启动用户表为空时播种；之后改密走设置 UI，此两项可删
ETERNA_ACCESS_ADMIN_USER=Mr.Ma
ETERNA_ACCESS_ADMIN_PASSWORD=<必填：管理员初始密码，≥8 位>

# 会话签名密钥：留空 = 自动生成落卷 secret.key（推荐）
# 手动设置会让全部旧会话下线（轮换语义）
ETERNA_ACCESS_SECRET=

# ── 外网入口（与 DSM 反代规则严格一致）───────────────────
# 浏览器面向的完整 https 根（含端口！）——登录桥接/同源信任均以此为准
ETERNA_PUBLIC_URL=https://<域名>:<端口>
# dsh /api fence 接受的 authority（host[:port]，空格分隔多个）
ETERNA_TRUSTED_HOST=<域名>:<端口> localhost:3210 127.0.0.1:3210
# 反代终结 TLS 时必须设 1（Secure cookie + 同源按 https 校验）
ETERNA_ACCESS_SECURE=1

# ── 可选 ─────────────────────────────────────────────────
# 租户工作区根目录（默认 $DSH_HOME/workspaces）
ETERNA_TENANT_ROOT=
# 数据目录（默认 $DSH_HOME/access）
ETERNA_ACCESS_DIR=

# ── Companion 浏览器执行面（可选功能，默认启用挂载）────────
# 中继鉴权令牌（红线 9）：留空 = 自动生成落卷 /data/relay-token（docker logs 提示路径）
# 显式设置便于多环境固定（扩展 options 里要填同一个值）
ETERNA_RELAY_TOKEN=
# 扩展实际连接地址（wss 前缀）：留空 = guide 页按 ws://127.0.0.1:9310/extension 展示
# 生产反代形态示例（DSM 反代把 /relay 路径转发到 本机:9310，见 deploy/README.md §5）：
# ETERNA_RELAY_PUBLIC_URL=wss://<域名>:<端口>/relay/extension
ETERNA_RELAY_PUBLIC_URL=
