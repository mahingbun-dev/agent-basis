# 关闭 pnpm run/exec 前的依赖同步自检(install-before-run)。
# 动机(T17 验收排障):非 11.7.0 的 pnpm 在 run 前自动 install 以单包 scope 解析,
# 不加载 workspace catalogs → ERR_PNPM_CATALOG_ENTRY_NOT_FOUND(@types/node catalog:default)
# → install 失败 → node_modules/.bin 链接不完整 → verify 首条 oxlint: command not found。
# CI 与本地均显式 pnpm install 后再跑脚本,关闭该自检不影响正确性,只去掉这条歧路。
verify-deps-before-run=false
