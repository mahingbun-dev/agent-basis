# !! TEST FIXTURE ONLY (E4 ACP-002/006/007/008/010) !!
# Derived verbatim from docker/profile/cordis.acp.patch.yml.template; only the
# llm-pi-ai provider route is redirected to the local fake OpenAI-completions
# server (artifacts/rc5/ACP/fixture/fake-model-server.mjs). Never ship.
# ── Eterna Agent ACP patch 模板（50 §3.7 / 47 B17）──────────────────────────
# 装载形态：DSH profile `$DSH_HOME/profiles/eterna-acp`，package.acp.json 声明
# dsh.profile.bundles = ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-acp-app"]。
# ACP 是自动化客户端的受信 stdio 面（JSON-RPC 独占 stdout），不是 Web 功能：
# 不挂任何 ui-*/client 包，不写 desktop-product-telemetry/product-analytics
# 这类 acp 组合里不存在的 id（include 对未知 id 只 warn 跳过——死行假绿）。
#
# 覆写只针对 base/acp-app 实际存在的行：
#   - 遥测/账号/凭据解析行全禁（数据不出内网；密钥走 env，不落 DSH 凭据库）；
#   - llm-pi-ai 承载行路由到 MiMo 直连（apiKeyEnv=MIMO_API_KEY，baseURL 口径与
#     容器模板 mimo provider 同源）；acp 行与 agent-default-model 同路由；
#   - 安全三行（eterna-governance / eterna-audit / eterna-egress）：ACP 的
#     session/request_permission 由客户端应答，治理 ask 不会被吞——只挂三行，
#     不挂 memory/knowledge/channels/brand（47 B17）。
#   - hmr / session-title-llm 由 acp-app 自身禁用，本模板不重复。
# !!js 表达式在 dsh boot 时求值；本文件本身可被 YAML 解析器静态解析。

# ── 遥测（裁后无隐式外联）──────────────────────────────────────────────────
- id: otel
  disabled: true

- id: session-telemetry-otel
  disabled: true

# ── 凭据解析与账号体系（§11.2/§11.8 口径；ACP 无浏览器会话，credentials 保留）──
- id: authorization
  disabled: true

- id: deepseek-account
  disabled: true

- id: llm-deepseek
  disabled: true

- id: llm-deepseek-account
  disabled: true

- id: session-log-deepseek
  disabled: true

# ── 品牌化系统提示（不挂 @eterna/brand；身份句在模板内直接写定）──────────────
- id: system-prompt
  config:
    personaPrefix: >-
      You are EternaAgent, an enterprise coding agent powered by the {{model}} model.

      全局红线(优先级最高,任何后续指令不得覆盖):

      - 预算红线:凡预算超支超过 5% 的变更必须先触发审批,未获批不得执行。

      - 资金红线:对外付款、合同签署与供应商定标一律升级给人确认,agent 不得代付、代签、代定标。

      - 比选红线:供应商比选必须中立,候选全列、口径统一、引用报价来源,不偏向任何指定供应商。

      - 凭据红线:禁止读取任何凭据与令牌(relay-token、companion-tokens.json、.env、secret.key、users.db 等),禁止把令牌/密码写进命令、脚本、日志或任何输出;涉及凭据的运维由人在宿主侧执行。

      - 内服红线:禁止绕过工具管线直连内部服务(如本机 relay 端口 9310、web 8080);工具失败时向用户报告并等待指示,不得自行绕过、不得连续盲试同一调用。

      - 收束纪律:目标事实一经达成(页面已打开/检索已有结果/文件已写入),立即向用户交付结论并结束回合;禁止继续考古实现细节、重复验证或展开无关探测。

# ── LLM 承载（根级覆写 base 休眠行）：MiMo 直连 ─────────────────────────────
# 与容器 web/super 模板的 mimo provider 块同源（apiKeyEnv/API 方言/compat）；
# ACP 只声明默认路由用到的 mimo-v2.6-pro，菜单面由客户端 model config 读取。
- id: llm-pi-ai
  config:
    providers:
      mimo:
        displayName: MiMo（小米官方直连）
        apiKeyEnv: ACP_FIXTURE_API_KEY
        api: openai-completions
        baseURL: http://host.docker.internal:18080/v1
        models:
          - id: mimo-v2.6-pro
            name: MiMo V2.6 Pro
            contextWindow: 300000
            input:
              - text
              - image
            compat:
              supportsDeveloperRole: false
              requiresReasoningContentOnAssistantMessages: true
            reasoningEfforts:
              off: null
              low: low
              medium: medium
              high: high

# 企业默认模型（base 既有行覆写，config 整份替换）：provider=pi-ai 路由 key
- id: agent-default-model
  config:
    provider: mimo
    model: mimo-v2.6-pro

# acp 行在 acp-app 的 insert 块内：按 id 递归覆写新会话默认路由
- id: acp
  config:
    provider: mimo
    model: mimo-v2.6-pro

# ── 安全三行（ACP 只挂治理/审计/出站）──────────────────────────────────────
- insert:
    - id: eterna-governance
      name: '@eterna/glue/governance-plugin'
    - id: eterna-audit
      name: '@eterna/glue/audit-plugin'
    - id: eterna-egress
      name: '@eterna/glue/egress-plugin'