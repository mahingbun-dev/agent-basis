+/**
+ * Convert array/object/class-inherited inject metadata into a plain map.
+ *
+ * Upstream held this under `namespace Inject { resolve }`; flattened for
+ * strip-only mode — access it as `InjectStatic.resolve(...)`.
+ *
+ * @param inject — the declaration to normalize; `null`/`undefined` add nothing.
+ * @param result — the map to fill (service name → intercept config or `null`).
+ * @returns `result`.
+ */
+function resolveInject(inject: Inject | null | undefined, result: Dict = Object.create(null)) {
+  if (!inject) return result
+  if (Array.isArray(inject)) {
+    for (const name of inject) {
+      result[name] = null
     }
-    return result
+  } else if (Reflect.has(inject, symbols.checkProto)) {
+    Object.assign(result, resolveInject(Object.getPrototypeOf(inject)))
+    for (const name of Object.keys(inject)) {
+      result[name] = inject[name] ?? null
+    }
+  } else {
+    for (const name of Object.keys(inject)) {
+      result[name] = inject[name] ?? null
+    }
   }
+  return result
 }
 
