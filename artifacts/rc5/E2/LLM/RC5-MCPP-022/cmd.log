EXIT=200
round1_echo=true round2_absent=true round2_tools_has=false

[ASSERT] 登出前 live 会话可调用个人工具并回显 => PASS :: ["echo:before-logout"]

[ASSERT] 登出返回 302 且清除浏览器会话 cookie（Max-Age=0） => PASS :: status=302 clear=true

[ASSERT] 登出后同一 live 会话 tools 清单不再含个人工具 => PASS :: tools=59 present=false

[ASSERT] 登出后调用被拒且无 echo 内容 => PASS :: ["echo:before-logout","Error: unknown tool \"mcp__p2_llm22__echo\""]
