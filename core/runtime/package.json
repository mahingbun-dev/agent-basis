  "dependencies": {
    "@core/cordis": "workspace:*",
    "@core/contracts": "workspace:*",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
