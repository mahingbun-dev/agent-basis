{
  "name": "@core/runtime",
  "description": "basis 运行时:bundle 清单装载(cordis 根 Context + 逐插件挂载)+ basis CLI(chat REPL / run 单 turn)。一切皆插件的装配器与入口。",
  "version": "0.1.0",
  "private": true,
